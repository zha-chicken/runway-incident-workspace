{
  "name": "runway-incident-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:import": "node --import tsx scripts/import-data.ts",
    "verify": "npm run data:import && npm run typecheck && npm test",
    "live:smoke": "node --use-env-proxy --env-file=.env.local --import tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
